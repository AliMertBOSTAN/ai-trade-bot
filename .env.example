# ============================================================
#  AI Trade Bot - Ortam Değişkenleri
#  Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
#  .env dosyasını ASLA git'e commit etmeyin.
# ============================================================

# --- RPC Endpoint'leri (kendi Alchemy/Infura/QuickNode URL'lerinizi girin) ---
RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BSC=https://bsc-dataseed.binance.org
RPC_POLYGON=https://polygon-rpc.com

# --- AI / LLM sağlayıcı ---
# Hem hibrit sinyalin LLM katmanı HEM de piyasa analisti (/analyst,
# CEX/DEX + haber karşılaştırma yorumu) bu key'i kullanır.
# Sağlayıcı: "deepseek" | "anthropic" | "openai" | "none"
LLM_PROVIDER=deepseek

# DeepSeek (varsayılan, OpenAI uyumlu API)
# Anahtarı https://platform.deepseek.com adresinden alın.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Anthropic-uyumlu sağlayıcı (Claude SDK'sı ile aynı format) ---
# ANTHROPIC_BASE_URL boşsa GERÇEK Claude'a gider.
# DeepSeek'i Anthropic formatında çağırmak için (deepseek-v4-pro) şu 4 satırı kullan:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   ANTHROPIC_API_KEY=<DeepSeek anahtarın>
#   ANTHROPIC_MODEL=deepseek-v4-pro      (hızlı/ucuz için: deepseek-v4-flash)
# İleride gerçek Claude'a geçmek için: ANTHROPIC_BASE_URL'i boşalt,
#   ANTHROPIC_API_KEY'i Claude anahtarınla değiştir, ANTHROPIC_MODEL=claude-opus-4-...
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anlık haber akışları (opsiyonel) ---
# Boş bırakılırsa varsayılanlar kullanılır:
# CoinDesk, Cointelegraph, Decrypt, The Defiant. Virgülle ayrılmış RSS URL'leri.
NEWS_FEEDS=

# --- Cüzdan (YALNIZCA gerçek işlem modu için; paper modda gerekmez) ---
# UYARI: Burası gerçek para. Asla ana cüzdanınızın anahtarını kullanmayın.
# Boş bırakırsanız bot yalnızca paper (simülasyon) modunda çalışır.
WALLET_PRIVATE_KEY=

# --- CEX (Binance spot) — GELECEK İÇİN, şu an opsiyonel ---
# Boş bırakılırsa Binance yalnızca VERİ için kullanılır (fiyat/karşılaştırma);
# hiçbir CEX emri gönderilmez. Trade izinli key+secret girilirse CexBroker
# (zincir-dışı, gas yok) devreye alınabilir. Test için:
#   BINANCE_BASE=https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_SECRET=
# BINANCE_BASE=https://api.binance.com

# --- Çalışma modu: "paper" | "live" ---
TRADING_MODE=paper

# --- Engine otomatik başlatma (Electron) ---
# Electron, Python engine'ini uygulamayla birlikte otomatik başlatır/durdurur.
# Kapatmak için 0 yapın (engine'i elle "uvicorn engine.app:app --port 8787"
# ile başlatırsınız). Özel Python yorumlayıcı yolu için ENGINE_PYTHON kullanın.
AUTO_START_ENGINE=1
# ENGINE_PYTHON=C:\path\to\python.exe

# ---------------------------------------------------------------------------
# execd — Rust emir-iletim servisi (ADR-0001). UYARI: WALLET_KEY YALNIZ execd'de.
# ---------------------------------------------------------------------------
EXEC_BACKEND=python          # python (varsayılan) | rust
EXECD_URL=http://127.0.0.1:8788
EXECD_PORT=8788
EXECD_MODE=paper             # paper | live  (live'a bilinçli geçin)
MAX_GAS_GWEI=150
# WALLET_KEY=0x...           # SADECE execd ortamı; Python motoru bunu GÖRMEMELİ
# FLASHBOTS_SIGNER_KEY=0x... # bundle kimlik anahtarı (cüzdandan ayrı)
# HYPERLIQUID_KEY=0x...      # perp imzalama
# EXECD_SHARED_SECRET=...    # yerel çağrı doğrulama header'ı (opsiyonel)

# ---------------------------------------------------------------------------
# Risk / işlem ayarı (kod düzenlemeden .env'den ayarla)
# ---------------------------------------------------------------------------
MIN_CONFIDENCE=0.73          # işlem açma eşiği (0..1). Düşür -> daha çok işlem
MAX_POSITION_USD=500         # tek pozisyonda azami $
MAX_OPEN_POSITIONS=5
MAX_GAS_GWEI=80

# ==========================================================================
#  Ekonomik veri takvimi + otonom araştırmacı (anahtarsız çalışır)
# ==========================================================================
# Bot, sen sormadan da haberleri okur VE ekonomik veri takvimini takip eder.
# Kaynaklar: BLS ICS (CPI/ÜFE/İstihdam), statik FOMC tablosu, haberden
# çıkarılan kripto olayları (unlock/ETF/upgrade) ve data/calendar_custom.json.

# --- Takvim freni (yüksek etkili veri penceresinde korunma) ---
CALENDAR_GUARD=1                 # 0 = fren tamamen kapalı
CALENDAR_PRE_MIN=90              # veriden kaç dk ÖNCE yeni alım durur
CALENDAR_POST_MIN=45             # veriden kaç dk SONRA yeni alım durur
CALENDAR_BLOCK_IMPORTANCE=0.8    # bu önemin üstü ALIMI BLOKLAR (CPI/NFP/FOMC)
CALENDAR_DERISK_IMPORTANCE=0.5   # bu önemin üstü pozisyonu KÜÇÜLTÜR (ÜFE, GSYH)
CALENDAR_DERISK_FACTOR=0.5       # küçültme çarpanı (0.5 = yarı boyut)
# Ek ICS takvimleri (virgülle). Örn. BEA (PCE) kendi ICS'ini yayınlarsa buraya.
CALENDAR_ICS_FEEDS=

# --- Otonom araştırmacı ---
RESEARCH_WATCHER=1               # 0 = araştırmacı kapalı
RESEARCH_INTERVAL_MIN=30         # kaç dakikada bir tur atar (5..360)
RESEARCH_LOOKAHEAD_H=48          # kaç saat ilerisini araştırır (2..336)
RESEARCH_MIN_IMPORTANCE=0.6      # bu önemin altındaki olay araştırılmaz
RESEARCH_REFRESH_H=8             # aynı olay en fazla bu sıklıkla tazelenir
RESEARCH_LLM=1                   # 0 = LLM yok, yalnızca sayısal not
RESEARCH_NOTIFY=1                # 0 = Telegram/Discord bildirimi gönderme

# --- Bildirim kanalları (araştırma notları + live işlem + kill-switch) ---
# Telegram: @BotFather'dan token, @userinfobot'tan chat id alınır.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_DESKTOP=0

# --- Canlı işlem güvenliği ---
# Ön-uçuş kontrolü (scripts/live_preflight.py) geçmeden live moda GEÇİLMEZ.
# Bu kontrolü zorla atlamak için (tavsiye edilmez):
LIVE_FORCE=0

# --- Kanıt kapısı (canlıya geçiş için ölçülmüş kenar şartı) ---
# Bot paper/shadow modda AŞAĞIDAKİ eşikleri sağlamadan live'a GEÇEMEZ.
LIVE_GATE=1
LIVE_GATE_MIN_TRADES=30            # en az kapanan işlem (istatistiksel anlamlılık)
LIVE_GATE_MIN_PROFIT_FACTOR=1.2    # kazanç/kayıp oranı
LIVE_GATE_MIN_NET_USD=0            # net PnL bu değerin üstünde olmalı
LIVE_GATE_MAX_DD_PCT=15            # equity düşüşü tavanı (%)
LIVE_GATE_WINDOW=500               # incelenecek son işlem sayısı

# --- Sinyal zaman dilimi (ÖLÇÜLDÜ) ---
# 4h önerilir. 1h ölçümlerde her eşikte zarar etti; 4h eşik 0.73'te pozitif ve
# al-tut'u geçti. Ayrıntı: docs/LIVE_READINESS.md
SIGNAL_INTERVAL=4h
MIN_CONFIDENCE=0.73

# ==========================================================================
#  KÜÇÜK SERMAYE PROFİLİ (örn. 100 $ ile Base üzerinde başlangıç)
# ==========================================================================
# Varsayılanlar 10.000 $'lık bir portföye göredir. 100 $ ile çalışacaksanız:
#   MAX_POSITION_USD=25        # tek pozisyon sermayenin ~%25'i
#   MAX_OPEN_POSITIONS=2       # 100 $'da 5 pozisyon = her biri anlamsız küçük
#   MIN_TRADE_USD=5            # Base'de tur gas ~0,005 $ → 5 $ ekonomik
#   RISK_PCT_PER_TRADE=0.02    # işlem başına sermayenin %2'si riske edilir
#   PAPER_SEED_USD=100
#   STARTING_CASH_USD=100
# Not: Ethereum L1'de MIN_TRADE_USD'yi 10'un altına ÇEKMEYİN (gas kârı yer).
MIN_TRADE_USD=10

# --- Hedef takibi (yalnızca raporlama; risk ayarlarını DEĞİŞTİRMEZ) ---
# DCA hesabında kullanılan "gerçekçi" yıllık getiri varsayımı.
GOAL_ASSUMED_CAGR=0.15

# ============================================================
#  PİYASA İSTİHBARATI (intel) — /intel/* panelleri + sinyal katmanı
#  Hepsi OPSİYONEL. Hiçbiri girilmese de paneller ücretsiz kaynaklarla
#  (Binance, Hyperliquid, DefiLlama, CoinGecko, Yahoo Finance, Coinbase,
#  alternative.me, CNN, bitcoin-data.com) çalışır.
# ============================================================

# --- Anahtar isteyen sağlayıcılar (girilmezse ilgili panel ücretsiz yedeğe
#     düşer ya da "kapalı" görünür; bot etkilenmez) ---
# CoinGlass: gerçek ETF net akışı (dolar), borsa rezervleri, likidasyon verisi.
#   Yoksa ETF paneli "vekil" moda düşer (yön/şiddet verir, dolar tutarı vermez).
COINGLASS_API_KEY=
# CoinMarketCap: global metrikler + dominans (yoksa CoinGecko kullanılır).
CMC_API_KEY=
# Nansen: zincir-üstü smart-money akışları (yoksa orderflow vekili kullanılır).
NANSEN_API_KEY=

# --- Hyperliquid cüzdan takibi ---
# Takip etmek istediğin cüzdanlar (virgülle ayrılmış). "Cüzdan Konumlanması"
# paneli bunların net LONG/SHORT dağılımını gösterir.
HL_WATCH_WALLETS=
# Hyperliquid'in GENEL PnL sıralaması tek seferde ~35 MB indirir; bu yüzden
# varsayılan kapalıdır. Açmak için 1 yap (bant genişliğine dikkat).
HL_LEADERBOARD=0

# --- Tazeleme & sinyal entegrasyonu ---
# Panelleri arka planda güncelleyen döngü. 0 = kapalı (paneller elle tazelenir).
INTEL_REFRESH=1
# Tazeleme aralığı (saniye, en az 60).
INTEL_REFRESH_S=180
# Panellerin birleşik "yapı skoru" sinyal motorunun güvenini modüle etsin mi?
# 0 = yalnızca görsel panel; sinyal motoru bugünkü haliyle kalır.
INTEL_SIGNAL=1
# Risk kapısı: yapı skoru karara TERS ve bu eşikten güçlüyse YENİ pozisyon
# açılmaz (mevcut pozisyonu kapatmayı asla engellemez). 0 = kapalı.
# Intel verisi yoksa kapı otomatik pasiftir.
INTEL_BLOCK_SCORE=0.6

# ============================================================
#  AI ANALIST — derinlik + otonom tarama
# ============================================================
# Analiz derinliği = LLM'in üretebileceği azami token. Kısa bütçe uzun
# gerekçeleri ortadan keser. kisa(500) | normal(1200) | derin(2400) |
# cok_derin(4000) — ya da doğrudan sayı yaz (ör. 1800).
ANALYST_DEPTH=normal
# Otonom tarama: analist kendi kendine izleme listesini tarasın mı?
# Kapalıyken sadece düğmeye basınca çalışır. Açıksa LLM tokenı harcar.
ANALYST_AUTO=0
# Periyodik tam tarama aralığı (dakika).
ANALYST_INTERVAL_MIN=30
# Taranacak semboller (virgüllü). Boşsa BTC,ETH,SOL,HYPE,BNB.
ANALYST_WATCHLIST=
# Olay tetikleyici: yapı skoru bu kadar sıçrarsa sıra beklemeden analiz et.
ANALYST_BIAS_DELTA=0.25

# ============================================================
#  HYPERLIQUID PERP MASASI (kaldıraçlı işlem)
#  Anahtar yoksa KAĞIT modda çalışır — gerçek fiyat/funding ile simülasyon.
# ============================================================
# --- Canlı emir bayrağı ---
# 0 = hiçbir gerçek emir gitmez (varsayılan). Canlıya geçmeden önce kağıt
# modda sonuçları gör; bu bayrağı SEN açarsın.
HL_LIVE=0
# Testnet'te dene (app.hyperliquid-testnet.xyz). Canlı öncesi önerilir.
HL_TESTNET=0

# --- İmzalama (iki yol desteklenir; API Wallet ÖNERİLİR) ---
# 1) API Wallet (agent key): app.hyperliquid.xyz → API Wallets'tan türetilir.
#    Sadece İŞLEM yetkisi vardır, PARA ÇEKEMEZ. Sızarsa fonların güvende kalır.
#    Bu yolda ANA hesap adresini de vermek ZORUNLUDUR.
HL_API_WALLET_KEY=
HL_ACCOUNT_ADDRESS=
# 2) Anahtar verilmezse mevcut şifreli keystore kullanılır
#    (WALLET_KEYSTORE_PATH + WALLET_KEYSTORE_PASSWORD).

# --- Kağıt mod başlangıç teminatı ---
HL_PAPER_SEED_USD=1000

# --- RİSK TAVANLARI (elle ve AI emirleri AYNI kapıdan geçer) ---
HL_MAX_LEVERAGE=5              # kaldıraç tavanı
HL_MAX_NOTIONAL_USD=500        # tek pozisyon nosyonel tavanı
HL_MAX_POSITIONS=3             # eşzamanlı açık pozisyon
HL_MAX_TOTAL_NOTIONAL=1500     # toplam maruziyet tavanı
HL_MAX_DAILY_LOSS_USD=100      # günlük gerçekleşen zarar kill-switch
HL_MIN_LIQ_DISTANCE=12         # girişte likidasyona asgari % mesafe
HL_COOLDOWN_S=300              # aynı sembolde iki emir arası bekleme

# --- AI OTOPİLOT (analist kendi kararıyla işlem açsın mı?) ---
# 1 yaparsan AI, aşağıdaki DAHA DAR tavanlar içinde onay istemeden pozisyon
# açıp kapatabilir. Gerçek parayla çalıştırmadan önce kağıt modda ölç.
HL_AI_AUTOPILOT=0
HL_AI_MAX_NOTIONAL_USD=200     # AI'ın tek emirde açabileceği tavan
HL_AI_MAX_LEVERAGE=3           # AI'ın kullanabileceği kaldıraç tavanı
HL_AI_MIN_CONFIDENCE=0.72      # bu güvenin altında AI işlem açmaz
